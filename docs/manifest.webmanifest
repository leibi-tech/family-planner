{
  "name": "Family-Planner",
  "short_name": "Family",
  "description": "Familie organisieren: Wochenmenü, Einkauf, ToDos, Kalender, Dokumente",
  "lang": "de-CH",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f5fc",
  "theme_color": "#efeaff",
  "icons": [
    {
      "src": "icon-0462c5a9-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-0462c5a9-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-0462c5a9-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}
